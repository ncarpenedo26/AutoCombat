import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PointStamped, Twist


class OrbitController(Node):
    """
    Simple controller to orbit a tennis ball using /ball_pose in the camera frame.

    Assumptions:
    - /ball_pose is a geometry_msgs/PointStamped in the camera frame
      with:
        x: right (+), left (-)
        y: down (+), up (-)   [we don't use it here]
        z: forward (+) from camera

    We:
    - latch the initial z as desired depth
    - keep x ~ 0 (ball centered in image horizontally) using yaw
    - keep z ~ desired_depth using forward/back motion
    - add a constant sideways velocity to orbit “to the right”
    """

    def __init__(self):
        super().__init__('orbit_controller')

        # Parameters
        self.declare_parameter('orbit_speed', 0.1)     # m/s sideways
        self.declare_parameter('k_yaw', 1.5)           # rad/s per meter of x error
        self.declare_parameter('k_radial', 0.5)        # m/s per meter of z error
        self.declare_parameter('ball_timeout', 0.5)    # seconds

        self.cmd_pub = self.create_publisher(Twist, '/cmd_vel', 10)
        self.ball_sub = self.create_subscription(
            PointStamped,
            '/ball_pose',
            self.ball_callback,
            10
        )

        self.last_ball_msg = None
        self.last_update_time = None
        self.desired_depth = None  # latched when we first see the ball

        # 30 Hz control loop
        self.timer = self.create_timer(1.0 / 30.0, self.control_loop)

        self.get_logger().info(
            'OrbitController started. Subscribing to /ball_pose, publishing /cmd_vel.'
        )

    def ball_callback(self, msg: PointStamped):
        """Store the latest ball pose and latch desired depth if needed."""
        self.last_ball_msg = msg
        self.last_update_time = self.get_clock().now()

        if self.desired_depth is None and msg.point.z > 0.0:
            self.desired_depth = msg.point.z
            self.get_logger().info(
                f'Latched desired depth at {self.desired_depth:.3f} m'
            )

    def control_loop(self):
        """Main control loop: compute and publish Twist commands."""
        twist = Twist()

        # If we’ve never seen the ball, stop
        if self.last_ball_msg is None or self.last_update_time is None:
            self.cmd_pub.publish(twist)
            return

        # Timeout safety: if ball_pose stops updating, stop robot
        now = self.get_clock().now()
        timeout = self.get_parameter('ball_timeout').get_parameter_value().double_value
        if (now - self.last_update_time).nanoseconds * 1e-9 > timeout:
            self.get_logger().warn_once('No recent /ball_pose, stopping robot.')
            self.cmd_pub.publish(twist)
            return

        orbit_speed = self.get_parameter('orbit_speed').get_parameter_value().double_value
        k_yaw = self.get_parameter('k_yaw').get_parameter_value().double_value
        k_radial = self.get_parameter('k_radial').get_parameter_value().double_value

        ball = self.last_ball_msg.point

        # Default depth latch if somehow not set yet
        if self.desired_depth is None and ball.z > 0.0:
            self.desired_depth = ball.z

        if self.desired_depth is None:
            # Still no valid depth; nothing we can do.
            self.cmd_pub.publish(twist)
            return

        # Errors in camera frame
        # x > 0: ball to the RIGHT of center (so we should yaw LEFT)
        # z > desired: ball farther away than desired (so we should drive FORWARD)
        err_x = ball.x
        err_z = ball.z - self.desired_depth

        # Control laws
        # Forward/back to control depth
        v_forward = -k_radial * err_z

        # Sideways to orbit (positive here = “right” in camera frame; flip sign if needed)
        v_side = orbit_speed

        # Yaw to keep ball centered horizontally
        yaw_rate = -k_yaw * err_x

        twist.linear.x = v_forward
        twist.linear.y = v_side
        twist.angular.z = yaw_rate

        self.cmd_pub.publish(twist)


def main(args=None):
    rclpy.init(args=args)
    node = OrbitController()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
